diff --git a/src/main/scala/vfu-rpred.scala b/src/main/scala/vfu-rpred.scala
index f70e839..fafc73a 100644
--- a/src/main/scala/vfu-rpred.scala
+++ b/src/main/scala/vfu-rpred.scala
@@ -24,17 +24,22 @@ class RPredLane(implicit p: Parameters) extends VXUModule()(p) {
   val fn = Reg(new VRPUFn)
   val cond = Reg(Bool())
 
-  when (io.op.valid) {
-    fn := io.op.bits
-    when (io.op.bits.op_is(FR_ALL)) { cond := Bool(true) }
-    when (io.op.bits.op_is(FR_ANY)) { cond := Bool(false) }
-  }
+  // A new op resets the accumulator. If the first operand strip arrives in the same cycle as the
+  // op, the original code let the accumulate assignment win, so the reduction started from the
+  // previous branch's result (a stale "true" kept @vp vcjal.any loops spinning forever).
+  val start = io.op.valid
+  val cur_fn = Mux(start, io.op.bits, fn)
+  val init = Mux(io.op.bits.op_is(FR_ALL), Bool(true), Bool(false))
+  val base = Mux(start, init, cond)
+  when (start) { fn := io.op.bits }
 
   io.req.ready := Bool(true)
-  when (io.req.fire) {
-    when (fn.op_is(FR_ALL)) { cond := cond & (io.req.bits.pred | ~io.req.bits.active).orR }
-    when (fn.op_is(FR_ANY)) { cond := cond | (io.req.bits.pred & io.req.bits.active).orR }
-  }
+  // ALL: every active element of this strip must have the predicate set (the original .orR made
+  // "all" behave like "any", so @!vp vcjal.all skipped a loop body as soon as one lane finished)
+  val acc_all = base & (io.req.bits.pred | ~io.req.bits.active).andR
+  val acc_any = base | (io.req.bits.pred & io.req.bits.active).orR
+  val acc = Mux(cur_fn.op_is(FR_ALL), acc_all, acc_any)
+  when (start || io.req.fire) { cond := Mux(io.req.fire, acc, base) }
 
   io.result.bits.cond := cond
 }
