+
+// 性能模型踪迹输出：设置环境变量 HWACHA_TRACE=<file> 时启用
+FILE *hwacha_trace_stream()
+{
+  static FILE *f = nullptr;
+  static bool init = false;
+  if (!init) {
+    init = true;
+    const char *path = getenv("HWACHA_TRACE");
+    if (path) f = fopen(path, "w");
+  }
+  return f;
+}
